{
  "name": "maeum5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
    "build": "vite build",
    "serve": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js --prod",
    "simulate": "node --env-file-if-exists=.env simulate.js",
    "reset": "node -e \"require('node:fs').rmSync('maeum5.db',{force:true})\"",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6"
  }
}
